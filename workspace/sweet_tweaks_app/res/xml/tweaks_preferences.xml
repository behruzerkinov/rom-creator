<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/category_display">
        <ListPreference
            android:key="pref_refresh_rate"
            android:title="@string/pref_refresh_rate"
            android:summary="@string/pref_refresh_rate_summary"
            android:defaultValue="120"
            android:entries="@array/refresh_rate_entries"
            android:entryValues="@array/refresh_rate_values" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_performance">
        <SwitchPreference
            android:key="pref_fast_charge"
            android:title="@string/pref_fast_charge"
            android:summary="@string/pref_fast_charge_summary"
            android:defaultValue="true" />
        <ListPreference
            android:key="pref_governor"
            android:title="@string/pref_governor"
            android:summary="@string/pref_governor_summary"
            android:defaultValue="reflex"
            android:entries="@array/governor_entries"
            android:entryValues="@array/governor_values" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_memory">
        <ListPreference
            android:key="pref_zram_size"
            android:title="@string/pref_zram_size"
            android:summary="@string/pref_zram_summary"
            android:defaultValue="5368709120"
            android:entries="@array/zram_entries"
            android:entryValues="@array/zram_values" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_mods">
        <Preference
            android:key="pref_open_launcher"
            android:title="@string/pref_open_launcher_settings"
            android:summary="Configure home screen grid, icon pack, and stacked recents" />
        <Preference
            android:key="pref_open_security"
            android:title="@string/pref_open_security_settings"
            android:summary="Open unlocked Game Turbo, FBO and performance mode" />
    </PreferenceCategory>

</PreferenceScreen>

